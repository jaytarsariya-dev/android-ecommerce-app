<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/lb" />
        </shape>
    </item>

    <!-- Dropdown arrow -->
    <item android:drawable="@drawable/ic_dropdown_arrow" android:gravity="end|center_vertical" />
</layer-list>
